{
    "name": "dokker/dicesim",
    "description": "Monte Carlo combat simulator for a d100-based tabletop RPG",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "diceSim\\": "includes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "diceSim\\Tests\\": "tests"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
